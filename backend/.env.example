ENVIRONMENT=development
AUTH_MODE=development
DATABASE_URL=postgresql+psycopg://vehicle:vehicle@localhost:5432/vehicle
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
STORAGE_PATH=.local/objects
STORAGE_BACKEND=local
# S3_BUCKET=
# OTLP_ENDPOINT=
CORS_ORIGINS=["http://localhost:3000"]
# APP_ENV_FILE can point to the original checkout's ignored .env in a worktree.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
APP_MODEL=gpt-6.1-sol
PLANNING_HORIZON=2030
AI_BATCH_SIZE=5
AI_TIMEOUT_SECONDS=300
AI_MAX_OUTPUT_TOKENS=24000
PDF_TIMEOUT_SECONDS=600
RESEARCH_MAX_SEARCHES=3
RESEARCH_MAX_SOURCES=6
RESEARCH_TIMEOUT_SECONDS=180
RESEARCH_MAX_BYTES=1048576
RESEARCH_MAX_TOKENS=6000
