{
  "name": "fwd-vehicle-insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:live": "vitest run --mode live testing/liveBackend.test.ts",
    "dev:mock": "vite --mode mock --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "dev:harness": "vite --mode harness --host 127.0.0.1",
    "test:acceptance": "vitest run testing/networkAcceptance.test.ts src/App.networkAcceptance.test.tsx src/accessibilityAcceptance.test.tsx"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
