# Export these variables for both the private renderer adapter and geometry worker.
GEOMETRY_TOKEN=replace-with-a-private-renderer-token
GEOMETRY_JOBS_PATH=.local/geometry-jobs
GEOMETRY_BASELINE_PATH=.local/bmw-i5-prepared/baseline.glb
GEOMETRY_CATALOG_PATH=.local/bmw-i5-prepared/catalog.json
GEOMETRY_BLENDER=blender
# Must match the RENDERER_URL origin reachable by the application API.
GEOMETRY_PUBLIC_URL=http://localhost:8090
GEOMETRY_TIMEOUT_SECONDS=180
GEOMETRY_AI_ENABLED=false
GEOMETRY_MODEL=gpt-6.1-sol
GEOMETRY_OPENAI_BASE_URL=https://api.openai.com/v1
# GEOMETRY_OPENAI_API_KEY=<private editing credential>
GEOMETRY_MAX_TOOL_ROUNDS=3
GEOMETRY_MAX_CORRECTION_ROUNDS=2
